[Unit]
Description=AnimeTracker Business (Spring Boot API)
Documentation=file:///opt/animetracker/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=zhaizz
Group=zhaizz
WorkingDirectory=/opt/animetracker/business
EnvironmentFile=/opt/animetracker/business/business.env
# 903MB 物理内存：堆需显式限制，否则 JVM 默认取 1/4 并挤压 MySQL/Redis
# UseSerialGC：小堆 + 2 核场景比 G1 更省内存、停顿更短
ExecStart=/home/zhaizz/.local/opt/jdk21/bin/java \
    -Xmx192m \
    -Xss512k \
    -XX:MaxMetaspaceSize=96m \
    -XX:MaxDirectMemorySize=64m \
    -XX:+UseSerialGC \
    -XX:+ExitOnOutOfMemoryError \
    -Djava.security.egd=file:/dev/urandom \
    -jar app.jar
Restart=always
RestartSec=5
SuccessExitStatus=143
# 超限时只杀本服务（Restart=always 自动拉起），避免内核 OOM killer 波及 MySQL 容器
MemoryMax=448M
MemoryHigh=384M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=at-business

[Install]
WantedBy=multi-user.target
