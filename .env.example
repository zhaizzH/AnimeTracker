# ===================================================================
# AnimeTracker 环境配置模板
# 复制为 .env 并填写真实值。所有密钥只保存在服务器上的 .env,严禁提交到 Git。
#   cp .env.example .env
# ===================================================================

# --- MySQL ---
MYSQL_DATABASE=anime_tracker
MYSQL_USER=animetracker
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Redis ---
REDIS_DATABASE=1
REDIS_PASSWORD=

# --- MinIO ---
MINIO_BUCKET=anime-tracker
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

# --- JWT (生产环境需要足够长的随机密钥, 缺失或过短将导致业务启动失败) ---
JWT_SECRET=
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000
JWT_MAX_LOGIN_FAILS=5
JWT_LOGIN_FAIL_WINDOW_MINUTES=300

# --- 管理端超级管理员用户 ID (业务库中已存在的用户主键) ---
AT_ADMIN_SUPERADMIN_ID=

# --- CORS (逗号分隔的 HTTPS 来源; 同域部署可留空) ---
AT_CORS_ALLOWED_ORIGINS=

# --- Resend 邮件 ---
RESEND_API_KEY=
RESEND_SEND_EMAIL=

# --- LLM: DeepSeek 官方直连 (agent 供应商优先级高于 DashScope) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_ROUTE=deepseek-chat

# --- LLM: 阿里云百炼 DashScope (未配置 DEEPSEEK_API_KEY 时使用) ---
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_MODEL_ROUTE=qwen3.7-plus

# --- TLS / Let's Encrypt (certbot) ---
DOMAIN=
CERT_EMAIL=

# --- 演示数据 (仅 tools profile 的 demo-seeder 使用) ---
ALLOW_DEMO_SEED=false
DEMO_USER_PASSWORD=

# --- 镜像 (本地开发留空, 使用 docker compose build 本地构建) ---
# 生产部署从 GHCR 拉取发布镜像时设置:
#   REGISTRY=ghcr.io/<owner>/animetracker, IMAGE_TAG=<发布版本标签, 如 v1.0.0>
REGISTRY=
IMAGE_TAG=

# --- 备份 (宿主机绝对路径, 供 deploy/scripts 备份脚本使用) ---
BACKUP_PATH=
