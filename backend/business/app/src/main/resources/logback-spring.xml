<?xml version="1.0" encoding="UTF-8"?>
<!-- 日志输出。
     本地/默认：控制台多行文本（含 traceId），简洁可读；
     prod：单行结构化 JSON（traceId 来自 MDC RequestIdFilter，service 固定标识），供容器抓取。
     隐私红线：不记录 JWT/密钥/提示词/请求体；上游错误体只在 warn 时记录状态码。 -->
<configuration>

    <!-- 本地控制台：整洁文本 -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} %mdc{traceId:-} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- 生产：单行结构化 JSON -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"animetracker-business"}</customFields>
                <fieldNames>
                    <timestamp>ts</timestamp>
                    <message>message</message>
                    <logger>logger</logger>
                    <thread>[ignore]</thread>
                    <levelValue>[ignore]</levelValue>
                    <version>[ignore]</version>
                    <loggerContext>[ignore]</loggerContext>
                </fieldNames>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

</configuration>
