# ---- DashScope LLM ----
DASHSCOPE_API_KEY=sk-your-key-here
LLM_MODEL=qwen-plus
LLM_MODEL_ROUTE=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_THINKING_BUDGET=2048

# ---- opencode-go 网关 (可选) ----
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# ---- Server ----
AGENT_HOST=0.0.0.0
AGENT_PORT=8090

# ---- Backend Spring Boot API ----
BACKEND_BASE_URL=http://localhost:8080

# ---- JWT (与 business 共享签名密钥, agent 本地验签) ----
JWT_SECRET=dev-secret-key-not-for-production-use-change-it

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173"]

# ---- 数据导入 importer (Bangumi) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anime_tracker
BANGUMI_ACCESS_TOKEN=
BANGUMI_USER_AGENT=zhaizzH/AnimeTracker
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anime-tracker
MINIO_PUBLIC_URL=http://localhost:9000
