# ---- DashScope LLM ----
DASHSCOPE_API_KEY=sk-your-key-here
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ---- Server ----
AGENT_HOST=0.0.0.0
AGENT_PORT=8090

# ---- Backend Spring Boot API ----
BACKEND_BASE_URL=http://localhost:8080

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Agent Runtime ----
AGENT_MAX_ITERATIONS=5

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173"]
