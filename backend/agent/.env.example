# ============================================================
# AnimeTracker Agent 环境配置模板

# 用法：复制为 .env 并按需填写；含密钥的字段必须替换为真实值
# 读取方：app/config.py（pydantic-settings）+ importer（load_dotenv/os.getenv）
# ============================================================

# ---------- LLM：供应商显式选择（deepseek|dashscope，必填） ----------
LLM_PROVIDER=
# DeepSeek 思考强度（仅 deepseek 生效：low/high/max）
LLM_REASONING_EFFORT=high
# 百炼 qwen3 思考 token 上限
LLM_THINKING_BUDGET=2048
# 采样温度：百炼生效；deepseek 思考模式下无效（保留仅作百炼用）
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ---------- DeepSeek 官方直连（LLM_PROVIDER=deepseek 时使用） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- 阿里云百炼 DashScope（LLM_PROVIDER=dashscope 时使用） ----------
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.7-plus


# ---------- Agent HTTP 服务 ----------
AGENT_HOST=0.0.0.0
AGENT_PORT=8090

# ---------- 业务后端（Spring Boot，agent 回调/联调用） ----------
BACKEND_BASE_URL=http://localhost:8080

# ---------- JWT（与 business 共享签名密钥，agent 本地验签） ----------
JWT_SECRET=dev-secret-key-not-for-production-use-change-it

# ---------- Redis（事件总线 / 状态缓存） ----------
REDIS_URL=redis://localhost:6379/0

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5173"]

# ============================================================
# 数据导入 importer（Bangumi → 业务库）— 独立 CLI，与 Agent 共用本 .env
# ============================================================

# --- Bangumi API ---
BANGUMI_BASE_URL=https://api.bgm.tv
BANGUMI_IMAGE_PROXY_URL=
BANGUMI_ACCESS_TOKEN=
BANGUMI_USER_AGENT=zhaizzH/AnimeTracker

# --- MySQL（业务库 anime_tracker） ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anime_tracker

# --- MinIO（封面转存） ---
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anime-tracker
