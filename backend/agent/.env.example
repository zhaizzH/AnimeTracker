# ============================================================
# AnimeTracker Agent 环境配置模板

# 用法：复制为 .env 并按需填写；含密钥的字段必须替换为真实值
# 读取方：app/config.py（pydantic-settings）+ importer（load_dotenv/os.getenv）
# ============================================================

# ---------- LLM：DashScope 百炼（默认模型 qwen3.7-plus；模型名带 deepseek/ 前缀则走 DeepSeek 官方直连） ----------
DASHSCOPE_API_KEY=sk-your-key-here


# ---------- DeepSeek 官方直连（可选；模型名带 deepseek/ 前缀即启用） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- LLM：DashScope 百炼（默认） ----------
LLM_MODEL=qwen3.7-plus
LLM_MODEL_ROUTE=qwen3.7-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_THINKING_BUDGET=2048


# ---------- Agent HTTP 服务 ----------
AGENT_HOST=0.0.0.0
AGENT_PORT=8090

# ---------- 业务后端（Spring Boot，agent 回调/联调用） ----------
BACKEND_BASE_URL=http://localhost:8080

# ---------- JWT（与 business 共享签名密钥，agent 本地验签） ----------
JWT_SECRET=dev-secret-key-not-for-production-use-change-it

# ---------- Redis（事件总线 / 状态缓存） ----------
REDIS_URL=redis://localhost:6379/0

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5173"]

# ============================================================
# 数据导入 importer（Bangumi → 业务库）— 独立 CLI，与 Agent 共用本 .env
# ============================================================

# --- Bangumi API ---
BANGUMI_BASE_URL=https://api.bgm.tv
BANGUMI_IMAGE_PROXY_URL=
BANGUMI_ACCESS_TOKEN=
BANGUMI_USER_AGENT=zhaizzH/AnimeTracker

# --- MySQL（业务库 anime_tracker） ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anime_tracker

# --- MinIO（封面转存） ---
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anime-tracker
